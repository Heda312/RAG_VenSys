from pathlib import Path
from huggingface_hub import snapshot_download

SAVE_PATH = Path("D:\\models")

print("Mulai download model BGE-M3 dari Hugging Face...")
snapshot_download(
    repo_id="BAAI/bge-m3",
    local_dir=SAVE_PATH,
    local_dir_use_symlinks=False # Memastikan file fisik (bukan shortcut) yang di-download
)
print(f"Selesai! Model tersimpan di: {SAVE_PATH.resolve()}")